# Porta em que o servidor Express (backend + frontend estático) vai rodar
PORT=3000

# URL base do serviço de busca do PNCP (usado pelo próprio portal pncp.gov.br/app/editais)
PNCP_SEARCH_URL=https://pncp.gov.br/api/search/

# URL base usada para montar o link oficial de cada licitação no portal do PNCP
PNCP_APP_URL=https://pncp.gov.br/app

# Timeout (ms) para cada requisição feita à API do PNCP
PNCP_TIMEOUT_MS=15000

# Quantidade de páginas buscadas na API do PNCP para cada palavra-chave (páginas mais recentes)
PNCP_MAX_PAGES_POR_PALAVRA=3

# Quantidade de itens por página solicitada à API do PNCP
PNCP_TAMANHO_PAGINA_UPSTREAM=50

# Tempo (segundos) que o resultado de uma busca fica em cache no backend
CACHE_TTL_SEGUNDOS=300
